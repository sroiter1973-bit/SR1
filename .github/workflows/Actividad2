usuario = input("Crear usuario: ")
contrasena = input("Crear contraseña de minimo 8 caracteres: ")

# Validaciones
if len(contrasena) <= 8:
    raise ValueError("Error, debe ingresar minimo 8 caracteres")

elif  not any(c.isdigit() for c in contrasena):
    raise ValueError("Error: Debe contener al menos un numero")

elif not any(c.isupper() for c in contrasena):
    raise ValueError("Error: Debe contener al menos una letra mayuscula")
elif not any(c.isdigit() for c in contrasena):
    raise ValueError("Error: Falta numero")

elif not any(c.isalpha() for c in contrasena):
    raise ValueError("Error: Falta letra")

else:
    print("Clave valida")
